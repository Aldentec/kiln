{
  "name": "@doriansmith/kiln",
  "version": "0.3.2",
  "description": "Accessible React component library for indie developers. WCAG AA, < 25 KB gzipped, zero dependencies, zero config. Install and ship in under 2 minutes.",
  "keywords": [
    "react",
    "component-library",
    "accessible",
    "wcag",
    "aria",
    "ui-components",
    "typescript",
    "lightweight",
    "zero-dependency",
    "design-system",
    "frontend",
    "indie-developer",
    "dark-mode",
    "mobile-first",
    "performant"
  ],
  "homepage": "https://kiln-ui.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aldentec/kiln.git"
  },
  "bugs": {
    "url": "https://github.com/Aldentec/kiln/issues"
  },
  "author": "Dorian Smith",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./kiln.css": "./dist/kiln.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node -e \"const fs=require('fs');fs.renameSync('dist/index.css','dist/kiln.css');fs.renameSync('dist/index.css.map','dist/kiln.css.map');\"",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src demo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "build:site": "vite build",
    "preview": "vite preview",
    "deploy:site": "npm run build:site && cd cdk && npm run deploy"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.9.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1"
  }
}
