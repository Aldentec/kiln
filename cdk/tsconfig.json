{
  "compilerOptions": {
    "target":           "ES2020",
    "lib":              ["es2020"],
    "module":           "commonjs",
    "moduleResolution": "node",
    "declaration":      true,
    "strict":           true,
    "noImplicitAny":    true,
    "strictNullChecks": true,
    "noImplicitThis":   true,
    "alwaysStrict":     true,
    "outDir":           "./dist",
    "rootDir":          "./",
    "esModuleInterop":  true,
    "skipLibCheck":     true,
    "forceConsistentCasingInFileNames": true
  },
  "include":  ["bin", "lib"],
  "exclude":  ["node_modules", "dist", "cdk.out"]
}
